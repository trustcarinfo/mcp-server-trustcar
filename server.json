      "identifier": "mcp-server-trustcar",
      "version": "1.0.2",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://trustcar.info/mcp"
    }
  ]
